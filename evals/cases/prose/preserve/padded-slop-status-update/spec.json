{
  "trap": "padded-slop",
  "split": "development",
  "surface": "internal status update",
  "protected": [
    ["1,840", "1840"],
    ["2,300", "2300"],
    ["38 ms", "38ms"],
    ["11 ms", "11ms"],
    ["22%", "22 percent"],
    "460",
    ["3 to 4 weeks", "3-4 weeks", "three to four weeks"],
    "tidectl move --queue <name> --verify",
    "ops bastion",
    "Nothing gets deleted from the old cluster until the verify step reports zero drift",
    "platform lead",
    "retry audit"
  ],
  "calibrations": [
    {
      "label": "estimate",
      "patterns": ["\\bestimat", "\\bexpect", "\\bprojected\\b", "\\bforecast"]
    },
    {
      "label": "not a guarantee",
      "patterns": [
        "not a guarantee",
        "no guarantee",
        "not guaranteed",
        "isn't guaranteed",
        "(?:can't|cannot|can not) guarantee",
        "not a promise",
        "isn't a promise",
        "no promise",
        "not promised"
      ]
    },
    {
      "label": "may shift",
      "patterns": [
        "\\b(?:may|might|could)\\b(?:\\s+\\w+){0,2}\\s+(?:shift|slip|change|move|slide|stretch|extend|grow)",
        "\\b(?:may|might|could)\\b(?:\\s+\\w+){0,2}\\s+(?:be later|take longer|run longer|run over)",
        "subject to change"
      ]
    }
  ],
  "no_new_numbers": true,
  "shorter_than_draft": true,
  "wrong_must_fail": [
    "no_new_numbers",
    "calibration:estimate",
    "calibration:not a guarantee",
    "calibration:may shift"
  ]
}
