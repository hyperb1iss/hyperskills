+        stock.adjust("MUG-02", "east", "E-04", -2, "damaged")
+        self.assertEqual(stock.take_held("east", "E-04", 3), 1)
+        self.assertEqual((stock.on_hand("MUG-02"), stock.reserved("MUG-02")), (0, 0))
 
 
