diff --git a/boxoffice/waitlist.py b/boxoffice/waitlist.py
new file mode 100644
index 0000000..2ad727e
--- /dev/null
+++ b/boxoffice/waitlist.py
@@ -0,0 +1,18 @@
+"""First-come waitlist for a sold-out event."""
+from collections import deque
+
+
+class Waitlist:
+    def __init__(self):
+        self._buyers = deque()
+
+    def __len__(self):
+        return len(self._buyers)
+
+    def join(self, buyer):
+        if buyer not in self._buyers:
+            self._buyers.append(buyer)
+        return self._buyers.index(buyer) + 1
+
+    def pop_next(self):
+        return self._buyers.popleft()
