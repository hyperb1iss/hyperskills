+def _header(headers, name):
+    wanted = name.lower()
+    for key, value in headers.items():
+        if key.lower() == wanted:
+            return value
+    return ""
+
+
+def _matches(candidate, secrets, timestamp, body):
+    return any(hmac.compare_digest(candidate, sign(secret, timestamp, body)) for secret in secrets)
+
+
