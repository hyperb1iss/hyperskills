diff --git a/storefront/tax.py b/storefront/tax.py
index b87db18..3423003 100644
--- a/storefront/tax.py
+++ b/storefront/tax.py
@@ -22,5 +22,6 @@ def rate_for(region):
 
 
 def tax_for(subtotal, region):
-    """Tax on a dollar subtotal, rounded half up to the cent."""
-    return (subtotal * rate_for(region)).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+    """Tax on a subtotal in integer cents, rounded half up to a whole cent."""
